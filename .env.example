# ── Environment configuration ──────────────────────────────────────────
# Only two variables matter to the app at build time:
#   VITE_ENABLE_MSW   the literal string "true" or "false" (MSW mock API)
#   VITE_API_BASE_URL "" (same-origin / dev-proxy) OR an http(s):// URL
# A third is dev-server only:
#   VITE_DEV_PROXY_TARGET  live backend the Vite dev server proxies to
#
# Committed files (no secrets — safe to commit):
#   .env.example  this file — documentation only, never loaded by Vite
#   .env.qa       npm run build:qa  — QA/dev build, MSW bundled + booted
# Production values are NOT committed: `npm run build` reads
# VITE_ENABLE_MSW / VITE_API_BASE_URL from the CI build environment
# (see .github/workflows/ci.yml). The API URL is public, not a secret.
#
# Local developer overrides go in `.env.local` (gitignored, H5) — copy
# one of the recipes below into it. Do NOT create `.env`; it is the
# lowest-priority source and offers no advantage over `.env.local`.
#
# Vite precedence (highest→lowest, per variable):
#   process env > .env.<mode>.local > .env.local > .env.<mode> > .env
# Env vars are read only at Vite startup — restart after edits.

# ─────────────────────────────────────────────────────────────────────
# Recipe (a) — DEFAULT: MSW mock backend (no network, no backend needed)
# When VITE_ENABLE_MSW=true the base URL may be omitted and is ignored;
# mock handlers match same-origin relative paths.
# ─────────────────────────────────────────────────────────────────────
VITE_ENABLE_MSW=true
VITE_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────────
# Recipe (b) — Dev-server proxy to the LIVE backend (bypasses CORS)
# The Vite dev server proxies fixed path prefixes to VITE_DEV_PROXY_TARGET.
# The browser stays same-origin so no preflight is needed; cookies are
# rewritten to localhost. The AWS API Gateway stage path (e.g. /prod)
# belongs in the TARGET value — http-proxy prepends it to the request path.
# ─────────────────────────────────────────────────────────────────────
#   VITE_ENABLE_MSW=false
#   VITE_API_BASE_URL=
#   VITE_DEV_PROXY_TARGET=https://<api-id>.execute-api.<region>.amazonaws.com/prod

# ─────────────────────────────────────────────────────────────────────
# Recipe (c) — Direct absolute URL (production-style; requires working CORS)
# ─────────────────────────────────────────────────────────────────────
#   VITE_ENABLE_MSW=false
#   VITE_API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod
