# Production build config -- committed (public toggle only, no secrets).
# Automatically picked up by "npm run build" (Vite production mode).
#
# VITE_API_BASE_URL is intentionally left COMMENTED so an unconfigured
# prod build fails the env gate loudly instead of silently pointing at
# a placeholder host. Set it here before deploy OR override via the
# host build environment (e.g. VITE_API_BASE_URL=https://api.rydee.pk).
#
# VITE_API_BASE_URL=https://api.example.com
VITE_ENABLE_MSW=false
