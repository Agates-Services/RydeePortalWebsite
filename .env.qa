# QA build config -- committed (public toggle only, no secrets).
# Consumed by "vite build --mode qa" (npm run build:qa).
# MSW is bundled and boots at load; VITE_API_BASE_URL is intentionally
# omitted -- the env validator allows it to be absent when
# VITE_ENABLE_MSW=true, and mock handlers match same-origin paths anyway.
VITE_ENABLE_MSW=true
